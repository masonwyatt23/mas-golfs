<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.masgolfs.cleanup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__MAS_GOLFS_HOME__/ops/cleanup.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>MAS_GOLFS_HOME</key>
		<string>__MAS_GOLFS_HOME__</string>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>__MAS_GOLFS_HOME__/ops/cleanup.log</string>
	<key>StandardErrorPath</key>
	<string>__MAS_GOLFS_HOME__/ops/cleanup.log</string>
</dict>
</plist>
